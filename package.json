{
  "name": "@wyre-ai/rootly-mcp",
  "version": "1.0.6",
  "description": "MCP server for the Rootly incident management platform",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "rootly-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "build:ui": "vite build && node scripts/embed-ui.mjs",
    "prebuild": "npm run clean",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "start:http": "MCP_TRANSPORT=http node dist/http.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "mcpb:pack": "npm run build && npm install --omit=dev --ignore-scripts && mcpb pack",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:dev": "npm run build && wrangler dev"
  },
  "keywords": [
    "rootly",
    "mcp",
    "incidents",
    "alerts",
    "on-call",
    "model-context-protocol",
    "msp",
    "wyre-technology"
  ],
  "author": "WYRE Technology",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/WYRE-AI/rootly-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@wyre-technology/node-rootly": "^1.0.2"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.0",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@types/node": "^26.6.4",
    "msw": "^3.0.1",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.146.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
